# Copy to .env for local development:  cp .env.example .env
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://wallet:wallet@localhost:5434/wallet
DB_POOL_MAX=10

# Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ISSUER=wallet-service
JWT_AUDIENCE=wallet-service-api
JWT_TTL_SECONDS=900

# First admin, created on start if missing (password never overwritten)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

DEFAULT_CURRENCY=NGN
MAX_TRANSACTION_AMOUNT=1000000000
LOG_LEVEL=info
CORS_ORIGINS=
SWAGGER_ENABLED=true
RATE_LIMIT_ENABLED=true
